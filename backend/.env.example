# Server
PORT=5000
NODE_ENV=development
# Comma-separated list of origins allowed to call this API
CLIENT_ORIGIN=http://localhost:5173
# Optional: trace | debug | info | warn | error | fatal (default: debug in dev, info in prod)
LOG_LEVEL=

# Supabase (Project Settings -> API) — used as the Postgres database only.
# Authentication is our own (bcrypt + JWT), not Supabase Auth.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Signs/verifies our own session tokens. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=your-random-secret-at-least-32-chars

# Cloudinary (Dashboard -> Account Details)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Razorpay (Test mode keys)
RAZORPAY_KEY_ID=your-test-key-id
RAZORPAY_KEY_SECRET=your-test-key-secret
